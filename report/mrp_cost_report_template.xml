<odoo>

<template id="report_mrp_real_cost">

    <t t-call="web.external_layout">
        <main>

            <h2>Relatório de Custos de Produção</h2>

            <t t-foreach="docs" t-as="doc">

                <!-- BUSCA DAS LINHAS CORRETAS -->
                <t t-set="lines"
                   t-value="env['mrp.real.cost.report'].search([
                       ('production_id','=',doc.id)
                   ], order='production_path')"/>

                <h3>
                    Ordem: <span t-esc="doc.name"/> -
                    <span t-field="doc.product_id.display_name"/>
                </h3>

                <p>
                    <strong>Data Finalização:</strong>
                    <span t-field="doc.date_finished"/>
                </p>

                <table class="table table-sm table-bordered">

                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Quantidade</th>
                            <th class="text-end">Custo Planejado</th>
                            <th class="text-end">Custo Real</th>
                            <th class="text-end">Variação</th>
                        </tr>
                    </thead>

                    <tbody>

                        <t t-foreach="lines" t-as="line">

                            <tr t-att-class="'fw-bold' if line.cost_type in ['production','total'] else ''">

                                <td>
                                    <span t-att-style="'padding-left:%spx' % (line.level * 20)"/>
                                    <span t-esc="line.item_name"/>
                                    <t t-if="line.cost_type == 'component'">
                                        <br/>
                                        <small class="text-muted">
                                            Produto: <span t-field="line.product_id.display_name"/>
                                        </small>
                                    </t>
                                </td>

                                <td class="text-end">
                                    <t t-if="line.quantity != 0">
                                        <span t-esc="'%.3f' % line.quantity"/>
                                        <t t-if="line.uom_id">
                                            <span t-esc="' ' + line.uom_id.name"/>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        -
                                    </t>
                                </td>

                                <td class="text-end">
                                    <span t-field="line.planned_cost"
                                          t-options='{"widget":"monetary", "display_currency": doc.currency_id or doc.company_id.currency_id}'/>
                                </td>

                                <td class="text-end">
                                    <span t-field="line.real_cost"
                                          t-options='{"widget":"monetary", "display_currency": doc.currency_id or doc.company_id.currency_id}'/>
                                </td>

                                <td class="text-end">

                                    <span t-att-class="
                                        'text-danger' if line.variance_cost &lt; 0
                                        else 'text-success' if line.variance_cost &gt; 0
                                        else ''">

                                        <span t-field="line.variance_cost"
                                              t-options='{"widget":"monetary", "display_currency": doc.currency_id or doc.company_id.currency_id}'/>

                                    </span>

                                </td>

                            </tr>

                        </t>

                    </tbody>

                    <!-- Linha de totais gerais -->
                    <tfoot>
                        <tr class="fw-bold bg-light">
                            <td>TOTAIS GERAIS</td>
                            <td class="text-end">-</td>
                            <td class="text-end">
                                <span t-esc="sum(lines.mapped('planned_cost'))"
                                      t-options='{"widget":"monetary", "display_currency": doc.currency_id or doc.company_id.currency_id}'/>
                            </td>
                            <td class="text-end">
                                <span t-esc="sum(lines.mapped('real_cost'))"
                                      t-options='{"widget":"monetary", "display_currency": doc.currency_id or doc.company_id.currency_id}'/>
                            </td>
                            <td class="text-end">
                                <span t-esc="sum(lines.mapped('variance_cost'))"
                                      t-options='{"widget":"monetary", "display_currency": doc.currency_id or doc.company_id.currency_id}'/>
                            </td>
                        </tr>
                    </tfoot>

                </table>

            </t>

        </main>
    </t>

</template>

</odoo>