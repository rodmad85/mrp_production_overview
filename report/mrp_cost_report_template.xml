<odoo>

<template id="report_mrp_real_cost">

    <t t-call="web.external_layout">
        <main>

            <h2>Relatório de Custos de Produção</h2>

            <t t-foreach="docs" t-as="doc">

                <!-- BUSCA DAS LINHAS CORRETAS -->
                <t t-set="lines"
                   t-value="env['mrp.real.cost.report'].search([('production_id','=',doc.id)], order='production_path')"/>

                <h3>
                    <span t-esc="doc.name"/> -
                    <span t-esc="doc.product_id.display_name"/>
                </h3>

                <table class="table table-sm table-bordered">

                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Item</th>
                            <th class="text-end">Qtd</th>
                            <th class="text-end">Planejado</th>
                            <th class="text-end">Real</th>
                            <th class="text-end">Variação</th>
                        </tr>
                    </thead>

                    <tbody>

                        <t t-foreach="lines" t-as="line">

                            <tr>

                                <td>
                                    <span t-esc="line.cost_type"/>
                                </td>

                                <td>
                                    <span t-att-style="'margin-left:%spx' % (line.level * 20)"/>
                                    <span t-esc="line.item_name"/>
                                </td>

                                <td class="text-end">
                                    <span t-esc="line.quantity"/>
                                </td>

                                <td class="text-end">
                                    <span t-field="line.planned_cost"
                                          t-options='{"widget":"monetary","display_currency":doc.company_id.currency_id}'/>
                                </td>

                                <td class="text-end">
                                    <span t-field="line.real_cost"
                                          t-options='{"widget":"monetary","display_currency":doc.company_id.currency_id}'/>
                                </td>

                                <td class="text-end">

                                    <span t-att-class="
                                        'text-danger' if line.variance_cost &lt; 0
                                        else 'text-success' if line.variance_cost &gt; 0
                                        else ''">

                                        <span t-field="line.variance_cost"
                                              t-options='{"widget":"monetary","display_currency":doc.company_id.currency_id}'/>

                                    </span>

                                </td>

                            </tr>

                        </t>

                    </tbody>

                </table>

            </t>

        </main>
    </t>

</template>

</odoo>