<odoo>

<template id="report_mrp_real_cost">

<t t-call="web.external_layout">

<t t-set="doc" t-value="doc"/>

<h2>
Relatório de Custos de Produção
</h2>

<p>

<strong>Ordem:</strong>
<span t-field="doc.name"/>

</p>

<table class="table table-sm">

<thead>

<tr>

<th>Tipo</th>
<th>Item</th>
<th>Qtd</th>
<th>Custo Unit</th>
<th>Total</th>

</tr>

</thead>

<tbody>

<t t-set="total_component" t-value="0"/>
<t t-set="total_labor" t-value="0"/>

<!-- COMPONENTES -->

<t t-foreach="doc.move_raw_ids" t-as="line">

<tr>

<td>Componente</td>

<td>

<span t-field="line.product_id"/>

</td>

<td>

<span t-field="line.quantity_done"/>

</td>

<td>

<t t-set="unit"
t-value="line.stock_valuation_layer_ids and line.stock_valuation_layer_ids[0].unit_cost or 0"/>

<span t-esc="unit"/>

</td>

<td>

<t t-set="cost"
t-value="line.stock_valuation_layer_ids and line.stock_valuation_layer_ids[0].value or 0"/>

<span t-esc="cost"/>

<t t-set="total_component"
t-value="total_component + cost"/>

</td>

</tr>

</t>

</tbody>

</table>

<br/>

<h4>

Subtotal Componentes:

<span t-esc="total_component"/>

</h4>

<br/>

<table class="table table-sm">

<thead>

<tr>

<th>Operação</th>
<th>Horas</th>
<th>Custo Hora</th>
<th>Total</th>

</tr>

</thead>

<tbody>

<t t-foreach="doc.workorder_ids" t-as="wo">

<tr>

<td>

<span t-field="wo.workcenter_id"/>

</td>

<td>

<t t-set="hours"
t-value="wo.duration / 60.0"/>

<span t-esc="hours"/>

</td>

<td>

<span t-field="wo.workcenter_id.costs_hour"/>

</td>

<td>

<t t-set="cost"
t-value="(wo.duration / 60.0) * wo.workcenter_id.costs_hour"/>

<span t-esc="cost"/>

<t t-set="total_labor"
t-value="total_labor + cost"/>

</td>

</tr>

</t>

</tbody>

</table>

<br/>

<h4>

Subtotal Mão de Obra:

<span t-esc="total_labor"/>

</h4>

<hr/>

<h3>

TOTAL PRODUÇÃO:

<span t-esc="total_component + total_labor"/>

</h3>

</t>

</template>


<report
    id="action_report_mrp_real_cost"
    model="mrp.production"
    string="Custos de Produção"
    report_type="qweb-pdf"
    name="mrp_real_cost.report_mrp_real_cost"
    file="mrp_real_cost.report_mrp_real_cost"
/>

</odoo>