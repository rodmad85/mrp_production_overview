<odoo>

<template id="report_mrp_real_cost">

<t t-call="web.external_layout">

<t t-set="o" t-value="doc"/>

<h2>Relatório de Custos de Produção</h2>

<p>

Ordem:
<strong><span t-field="o.name"/></strong>

</p>

<table class="table table-sm">

<thead>

<tr>

<th>Tipo</th>
<th>Item</th>
<th>Qtd</th>
<th>Planejado</th>
<th>Real</th>
<th>Variação</th>

</tr>

</thead>

<tbody>

<t t-foreach="docs.env['mrp.real.cost.report'].search([('production_id','=',o.id)])" t-as="line">

<tr>

<td>

<span t-field="line.cost_type"/>

</td>

<td>

<span t-esc="line.item_name"/>

</td>

<td>

<span t-field="line.quantity"/>

</td>

<td>

<span t-field="line.planned_cost"/>

</td>

<td>

<span t-field="line.real_cost"/>

</td>

<td>

<span t-field="line.variance_cost"/>

</td>

</tr>

</t>

</tbody>

</table>

</t>

</template>

    <report
    id="action_report_mrp_real_cost"
    model="mrp.production"
    string="Custos de Produção"
    report_type="qweb-pdf"
    name="mrp_real_cost.report_mrp_real_cost"
    file="mrp_real_cost.report_mrp_real_cost"
/>

</odoo>