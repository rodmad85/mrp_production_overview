<odoo>

<template id="report_mrp_real_cost">

<t t-call="web.external_layout">

<main>

<h2>Relatório de Custos de Produção</h2>

<t t-set="lines"
   t-value="env['mrp.real.cost.report'].search([('production_id','=',doc.id)])"/>

<table class="table table-sm">

<thead>
<tr>
<th>Tipo</th>
<th>Item</th>
<th>Qtd</th>
<th>Planejado</th>
<th>Real</th>
<th>Variação</th>
</tr>
</thead>

<tbody>

<t t-foreach="lines" t-as="l">

<tr>

<td><span t-field="l.cost_type"/></td>

<td><span t-esc="l.item_name"/></td>

<td><span t-field="l.quantity"/></td>

<td><span t-field="l.planned_cost"/></td>

<td><span t-field="l.real_cost"/></td>

<td><span t-field="l.variance_cost"/></td>

</tr>

</t>

</tbody>

</table>

</main>

</t>

</template>

</odoo>