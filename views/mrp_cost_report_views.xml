<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_real_cost_tree" model="ir.ui.view">
        <field name="name">mrp.real.cost.tree</field>
        <field name="model">mrp.real.cost.report</field>
        <field name="arch" type="xml">
            <tree default_order="production_path"
                  decoration-info="cost_type=='production'"
                  decoration-success="cost_type=='total'"
                  decoration-primary="cost_type=='subproduction'"
                  js_class="cost_report_list"
            >

                <!-- Campos invisíveis -->
                <field name="production_path" invisible="1"/>
                <field name="level" invisible="1"/>
                <field name="cost_type" invisible="1"/>
                <field name="parent_production_id" invisible="1"/>
                <field name="unfolded" invisible="1"/>
                <field name="currency_id" invisible="1"/>

                <!-- Campos visíveis -->
                <field name="display_name" string="Item"/>
                <field name="quantity" string="Quantidade" sum="Total" widget="float" digits="[16,4]"/>
                <field name="uom_id" string="Unid." optional="show"/>
                <field name="qty_to_consume" string="Para Consumo" optional="hide" widget="float" digits="[16,4]"/>
                <field name="qty_consumed" string="Consumido" optional="hide" widget="float" digits="[16,4]"/>
                <field name="planned_cost" string="Planejado" sum="Total" widget="monetary"/>
                <field name="real_cost" string="Real" sum="Total" widget="monetary"/>
                <field name="variance_cost" string="Variação" sum="Total" widget="monetary"
                       decoration-danger="variance_cost &lt; -0.001"
                       decoration-success="variance_cost &gt; 0.001"/>
                <field name="production_id" invisible="1"/>
                <field name="product_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="action_mrp_real_cost_report" model="ir.actions.act_window">
        <field name="name">Custos Reais de Produção</field>
        <field name="res_model">mrp.real.cost.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_mrp_real_cost_tree"/>
        <field name="context">{'search_default_production_id': [active_id]}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Os dados serão carregados automaticamente ao abrir esta view.
                Se estiver vazio, aguarde ou clique no botão "Atualizar".
            </p>
        </field>
    </record>

    <!-- Botão de atualizar na árvore -->
    <record id="action_refresh_cost_report" model="ir.actions.server">
        <field name="name">Atualizar Relatório de Custos</field>
        <field name="model_id" ref="model_mrp_real_cost_report"/>
        <field name="binding_model_id" ref="model_mrp_real_cost_report"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
action = model.refresh_report()
        </field>
    </record>

    <!-- Botão na ordem de produção -->
    <record id="mrp_production_form_cost_button" model="ir.ui.view">
        <field name="name">mrp.production.cost.button</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_mrp_real_cost_report)d"
                        string="Custos Reais"
                        type="action"
                        class="btn-primary"
                        groups="base.group_user"/>
            </xpath>
        </field>
    </record>

    <!-- Filtros de busca -->
    <record id="view_mrp_real_cost_search" model="ir.ui.view">
        <field name="name">mrp.real.cost.search</field>
        <field name="model">mrp.real.cost.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="display_name"/>

                <filter name="production_only"
                        string="Apenas Ordens"
                        domain="[('cost_type','=','production')]"/>
                <filter name="components_only"
                        string="Apenas Componentes"
                        domain="[('cost_type','=','component')]"/>
                <filter name="subproductions_only"
                        string="Apenas Subproduções"
                        domain="[('cost_type','=','subproduction')]"/>
                <filter name="operations_only"
                        string="Apenas Operações"
                        domain="[('cost_type','=','operation')]"/>

                <separator/>

                <filter name="positive_variance"
                        string="Variação Positiva"
                        domain="[('variance_cost','&gt;',0.001)]"/>
                <filter name="negative_variance"
                        string="Variação Negativa"
                        domain="[('variance_cost','&lt;',-0.001)]"/>
                <filter name="zero_variance"
                        string="Variação Zero"
                        domain="[('variance_cost','&gt;=',-0.001),('variance_cost','&lt;=',0.001)]"/>

                <group expand="0" string="Agrupar por">
                    <filter name="group_production"
                            string="Ordem"
                            context="{'group_by':'production_id'}"/>
                    <filter name="group_product"
                            string="Produto"
                            context="{'group_by':'product_id'}"/>
                    <filter name="group_cost_type"
                            string="Tipo"
                            context="{'group_by':'cost_type'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>