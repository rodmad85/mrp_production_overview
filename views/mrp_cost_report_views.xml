<odoo>

    <record id="view_mrp_real_cost_tree" model="ir.ui.view">
        <field name="name">mrp.real.cost.tree</field>
        <field name="model">mrp.real.cost.report</field>
        <field name="arch" type="xml">
            <tree string="Custos Produção">

                <field name="production_id"/>
                <field name="cost_type"/>
                <field name="item_name"/>
                <field name="quantity"/>
                <field name="unit_cost"/>
                <field name="total_cost" sum="Total"/>

            </tree>

        </field>
    </record>

    <record id="view_mrp_real_cost_pivot" model="ir.ui.view">
        <field name="name">mrp.real.cost.pivot</field>
        <field name="model">mrp.real.cost.report</field>
        <field name="arch" type="xml">
            <pivot>

                <field name="production_id" type="row"/>
                <field name="cost_type" type="row"/>
                <field name="item_name" type="row"/>
                <field name="total_cost" type="measure"/>

            </pivot>
        </field>
    </record>

</odoo>